    m_Localized: "\u30AB\u30FC\u30C9\u3084\u6575\u306F\u3055\u307E\u3056\u307E\u306A\u52B9\u679C\u3092\u6301\u3063\u3066\u3044\u307E\u3059\u3002\n\u5BFE\u8C61\u304C\u53D7\u3051\u3066\u3044\u308B\u52B9\u679C\u306FHP\u30D0\u30FC\u306E\u4E0B\u306B\u8868\u793A\u3055\u308C\u307E\u3059\u3002"
