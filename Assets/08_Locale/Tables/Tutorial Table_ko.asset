  m_TableData:
  - m_Id: 45997371392
    m_Localized: "\uCE74\uB4DC\uC5D0\uB294 \uCE74\uB4DC\uC758 \uBE44\uC6A9, \uD6A8\uACFC,
      \uD0C0\uC785 \uB4F1\uC758 \uC815\uBCF4\uAC00 \uC788\uC2B5\uB2C8\uB2E4.\n\uCE74\uB4DC\uC758
      \uD0C0\uC785 \uC6B0\uCE21 \uC0C1\uB2E8\uC5D0 \uD45C\uC2DC\uB418\uC5B4 \uC788\uC73C\uBA70
      \uCE90\uB9AD\uD130\uB9C8\uB2E4 3\uAC00\uC9C0 \uD0C0\uC785\uC744 \uAC00\uC9C0\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\n\uCE74\uB4DC\uB97C \uB300\uC0C1\uC5D0\uAC8C \uB4DC\uB798\uADF8\uD558\uC5EC
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC5B8\uC81C\uB4E0\uC9C0
      \uD134 \uC885\uB8CC \uBC84\uD2BC\uC744 \uB20C\uB7EC \uCC28\uB840\uB97C \uB9C8\uCE60
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 168156475392
    m_Localized: "\r\n\r\n\uB9C8\uB098\uC640 \uD328\uC758 \uCE74\uB4DC\uB294 \uD134\uC774
      \uC2DC\uC791\uB420 \uB54C \uB2E4\uC2DC \uCC44\uC6CC\uC9D1\uB2C8\uB2E4.\n\uC88C\uCE21
      \uC0C1\uB2E8\uC758 \uC544\uC774\uCF58\uC744 \uD074\uB9AD\uD558\uC5EC \uCE90\uB9AD\uD130\uC758
      \uB371\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 186011627520
    m_Localized: "\uC6B0\uCE21 \uC0C1\uB2E8\uC758 '\uB3C4\uB85C\uC2DC\uC758 \uCC45'\uC744
      \uD1B5\uD574 \uD574\uAE08\uB41C \uCE74\uB4DC\uB97C \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB610\uD55C
      \uC124\uC815\uCC3D\uC5D0\uC11C \uC74C\uB7C9\uC744 \uC870\uC808\uD558\uAC70\uB098
      \uBAA8\uD5D8 \uC911 \uD0C0\uC774\uD2C0\uB85C \uB3CC\uC544\uAC08 \uC218\uB3C4
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 200611999744
    m_Localized: "\r\n\uAC01 \uCE90\uB9AD\uD130\uB294 2\uAC1C\uC758 '\uC2A4\uD0E0\uC2A4'\uB97C
      \uAC16\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uC2A4\uD150\uC2A4\uB294 \uD134\uB9C8\uB2E4
      \uD574\uB2F9 \uCE90\uB9AD\uD130\uC758 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD558\uAE30
      \uC804\uC774\uB77C\uBA74 \uC790\uC720\uB86D\uAC8C \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAC01
      \uC2A4\uD150\uC2A4\uC758 \uD6A8\uACFC\uB294 \uBC84\uD2BC\uC5D0 \uCEE4\uC11C\uB97C
      \uC62C\uB824\uC11C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4084201959424
    m_Localized: "\n: \uACF5\uACA9\uB825\uACFC \uBC29\uC5B4\uB825\n: \uBCF4\uD638
      \uC0C1\uD0DC\uC778 \uCE90\uB9AD\uD130\uB294 \uD53C\uD574 \uBA74\uC5ED\n: \uAE30\uC808
      \uC0C1\uD0DC\uC778 \uCE90\uB9AD\uD130\uB294 \uD589\uB3D9 \uBD88\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 3748351455232
    m_Localized: "\uCE74\uB4DC\uB4E4\uC740 \uB2E4\uC591\uD55C \uD6A8\uACFC\uB97C
      \uAC00\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uCE90\uB9AD\uD130\uAC00 \uBC1B\uACE0
      \uC788\uB294 \uD6A8\uACFC\uB294 \uCCB4\uB825\uBC14 \uD558\uB2E8\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 220631412736
    m_Localized: "\uC6B0\uCE21 \uC0C1\uB2E8\uC758 '\uB3C4\uB85C\uC2DC\uC758 \uCC45'\uC744
      \uD1B5\uD574 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uCE74\uB4DC\uB97C \uBCFC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB610\uD55C \uC124\uC815\uCC3D\uC5D0\uC11C
      \uC74C\uB7C9\uC870\uC808 \uBC0F \uD574\uC0C1\uB3C4\uB97C \uC120\uD0DD\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBAA8\uD5D8 \uC911 \uD0C0\uC774\uD2C0\uB85C
      \uB3CC\uC544\uAC08 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 232937500672
    m_Localized: "\uC6B0\uCE21 \uC0C1\uB2E8\uC758 '\uB3C4\uB85C\uC2DC\uC758 \uCC45'\uC744
      \uD1B5\uD574 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uCE74\uB4DC\uB97C \uBCFC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB610\uD55C \uC124\uC815\uCC3D\uC5D0\uC11C
      \uC74C\uB7C9\uC870\uC808 \uBC0F \uD574\uC0C1\uB3C4\uB97C \uC120\uD0DD\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBAA8\uD5D8 \uC911 \uD0C0\uC774\uD2C0\uB85C
      \uB3CC\uC544\uAC08 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 243196768256
    m_Localized: "\uBAA8\uD5D8\uC744 \uC0C8\uB85C \uC2DC\uC791\uD560 \uB54C\uB9C8\uB2E4
      \uC0C8\uB85C\uC6B4 \uCE74\uB4DC\uB97C \uD574\uAE08\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC804\uD22C\uC5D0\uC11C
      \uD68D\uB4DD\uD55C \uC804\uB9AC\uD488\uC744 \uC18C\uBE44\uD558\uC5EC \uC6D0\uD558\uB294
      \uD0C0\uC785\uC758 \uCE74\uB4DC\uB97C \uD574\uAE08\uD574\uBCF4\uC138\uC694.\n\uD574\uAE08\uD560
      \uC218 \uC5C6\uB294 \uD0C0\uC785\uC758 \uBC84\uD2BC\uC740 \uAC80\uAC8C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276424044544
    m_Localized: "\uCD95\uD558\uD569\uB2C8\uB2E4. \uD604\uC7AC \uAD6C\uD604\uB41C
      \uBAA8\uB4E0 \uC2A4\uD14C\uC774\uC9C0\uB97C \uD074\uB9AC\uC5B4\uD558\uC168\uC2B5\uB2C8\uB2E4.\n\uB2E4\uC2DC
      \uBAA8\uD5D8\uC744 \uC2DC\uC791\uD558\uC2DC\uBA74 \uC0C8\uB85C\uC6B4 \uCE74\uB4DC\uC640
      \uD568\uAED8 \uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD50C\uB808\uC774\uD574\uC8FC\uC154\uC11C
      \uAC10\uC0AC\uB4DC\uB9AC\uBA70 \uC88B\uC740 \uC2DC\uAC04\uC774 \uB418\uC168\uB2E4\uBA74
      \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 592599068672
    m_Localized: "<sprite=1>   : \uD654\uC5FC          <sprite=2>   : \uBE59\uACB0          
      <sprite=0>   : \uC790\uC5F0\n<sprite=4>   : \uAE30\uB3C4          <sprite=5>  
      : \uC131\uB825       <sprite=3>   : \uC138\uB840\n<sprite=7>   : \uCC38\uACA9         
      <sprite=8>   : \uD0C0\uACA9           <sprite=6>   : \uBC29\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 891279650816
    m_Localized: "\uAC01 \uD0C0\uC785\uBCC4 \uCE74\uB4DC\uB4E4\uC740 \uC5F0\uACC4\uB418\uC5B4
      \uD6A8\uACFC\uAC00 \uAC15\uD654\uB418\uB294 \uB300\uC751 \uD0C0\uC785\uC774
      \uC874\uC7AC\uD558\uBA70,\n\uC5F0\uACC4 \uD6A8\uACFC\uC758 \uB300\uC0C1\uC774
      \uB418\uB294 \uCE74\uB4DC\uB294 \uD14C\uB450\uB9AC\uAC00 \uD2B9\uBCC4\uD55C
      \uC774\uD399\uD2B8\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
