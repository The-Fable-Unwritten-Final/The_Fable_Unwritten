  m_TableData:
  - m_Id: 45997371392
    m_Localized: "\uCE74\uB4DC\uC5D0\uB294 \uCE74\uB4DC\uC758 \uBE44\uC6A9, \uD6A8\uACFC,
      \uD0C0\uC785 \uB4F1\uC758 \uC815\uBCF4\uAC00 \uC788\uC2B5\uB2C8\uB2E4.\n\uCE74\uB4DC\uC758
      \uD0C0\uC785 \uC6B0\uCE21 \uC0C1\uB2E8\uC5D0 \uD45C\uC2DC\uB418\uC5B4 \uC788\uC73C\uBA70
      \uCE90\uB9AD\uD130\uB9C8\uB2E4 3\uAC00\uC9C0 \uD0C0\uC785\uC744 \uAC00\uC9C0\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\n\uCE74\uB4DC\uB97C \uB300\uC0C1\uC5D0\uAC8C \uB4DC\uB798\uADF8\uD558\uC5EC
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC5B8\uC81C\uB4E0\uC9C0
      \uD134 \uC885\uB8CC \uBC84\uD2BC\uC744 \uB20C\uB7EC \uCC28\uB840\uB97C \uB9C8\uCE60
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 168156475392
    m_Localized: "\uCF54\uC2A4\uD2B8\uC640 \uD328\uC758 \uCE74\uB4DC\uB294 \uD134\uC774
      \uC2DC\uC791\uB420 \uB54C \uB2E4\uC2DC \uCC44\uC6CC\uC9D1\uB2C8\uB2E4.\n\uC0C1\uB2E8\uC758
      \uCE90\uB9AD\uD130 \uC544\uC774\uCF58\uC744 \uD074\uB9AD \uC2DC\n\uCE90\uB9AD\uD130\uAC00
      \uD604\uC7AC \uBCF4\uC720\uD55C \uCE74\uB4DC\uB97C \uD655\uC778 \uAC00\uB2A5
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 186011627520
    m_Localized: "\uC6B0\uCE21 \uC0C1\uB2E8\uC758 \uC9C0\uB3C4\uB97C \uD1B5\uD574,
      \uD604\uC7AC \uC9C4\uD589 \uC0C1\uD0DC \uBBF8\uB2C8\uB9F5\uC744 \uD655\uC778
      \uAC00\uB2A5\uD558\uBA70,\n\uCE74\uB4DC \uB3C4\uAC10 \uBC0F \uC124\uC815 \uC5D0
      \uC811\uADFC \uAC00\uB2A5 \uD569\uB2C8\uB2E4.\n\n\uC6B0\uCE21 \uD558\uB2E8\uC758
      \uBB38\uCCB4 \uD3B8\uC9D1\uC18C\uC5D0\uC11C\uB294 \n\uC804\uD22C\uB97C \uD1B5\uD574\uC11C
      \uD68D\uB4DD\uD55C \uC789\uD06C\uB97C \uC0AC\uC6A9\uD558\uC5EC \uB2A5\uB825\uC744
      \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 200611999744
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 4084201959424
    m_Localized: ": \uACF5\uACA9\uB825\uACFC \uBC29\uC5B4\uB825\n: \uBCF4\uD638 \uC0C1\uD0DC\uC778
      \uCE90\uB9AD\uD130\uB294 \uD53C\uD574 \uBA74\uC5ED\n: \uAE30\uC808 \uC0C1\uD0DC\uC778
      \uCE90\uB9AD\uD130\uB294 \uD589\uB3D9 \uBD88\uAC00\n: \uC0C1\uD0DC \uC774\uC0C1
      \uB514\uBC84\uD504"
    m_Metadata:
      m_Items: []
  - m_Id: 3748351455232
    m_Localized: "\uCE74\uB4DC \uBC0F \uC801\uB4E4\uC740 \uB2E4\uC591\uD55C \uD6A8\uACFC\uB97C
      \uAC00\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uB300\uC0C1\uB4E4\uC774 \uBC1B\uACE0
      \uC788\uB294 \uD6A8\uACFC\uB294 \uCCB4\uB825\uBC14 \uD558\uB2E8\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 220631412736
    m_Localized: "\uAC01 \uC2A4\uD14C\uC774\uC9C0\uC5D0\uC11C \uC9C4\uD589 \uAC00\uB2A5\uD55C
      \uB178\uB4DC\uC758 \uC885\uB958\uB294 \uC544\uB798\uC640 \uAC19\uC2B5\uB2C8\uB2E4.\n\n\uC804\uD22C
      : \uBAA8\uD5D8\uC744 \uBC29\uD574\uD558\uB294 \uC801\uACFC \uC804\uD22C\uD558\uC5EC
      <color=blue>\uC789\uD06C</color=blue>\uB97C \uD68D\uB4DD\n\uD734\uC2DD : \uC804\uD22C\uB85C
      \uC778\uD574 \uC313\uC778 <color=orange>\uD53C\uD574\uB97C \uD68C\uBCF5\uD558\uACE0
      \uCE74\uB4DC\uB97C \uC81C\uAC70</color=orange>\n\uC870\uC6B0 : \uC6B0\uC5F0\uD55C
      \uB9CC\uB0A8\uC744 \uD1B5\uD574\uC11C <color=green>\uB79C\uB364\uD55C \uBC84\uD504/\uB514\uBC84\uD504</color>
      \uD68D\uB4DD\n\uC5D8\uB9AC\uD2B8 : \uAC01 \uC2A4\uD14C\uC774\uC9C0 \uBCC4 \uB4F1\uC7A5\uD558\uB294
      <color=red>\uAC15\uB825\uD55C \uC801</color=red> \uC870\uC6B0"
    m_Metadata:
      m_Items: []
  - m_Id: 232937500672
    m_Localized: "\uCEA0\uD504"
    m_Metadata:
      m_Items: []
  - m_Id: 243196768256
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 276424044544
    m_Localized: "\uAC10\uC0AC\uD569\uB2C8\uB2E4.\n\uC5BC\uB9AC \uC5D1\uC138\uC2A4
      \uB2E8\uACC4\uC5D0\uC11C\uB294 4\uC2A4\uD14C\uC774\uC9C0 \uAE4C\uC9C0\uB9CC
      \uAC1C\uBC29\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uBE60\uB978 \uC2DC\uC77C
      \uB0B4\uC5D0 \uC815\uC2DD \uCD9C\uC2DC\uB97C \uD1B5\uD574 \uB354 \uB9CE\uC740
      \uC2A4\uD14C\uC774\uC9C0\uB97C\n\uC81C\uACF5\uD574 \uB4DC\uB9B4 \uC218 \uC788\uB3C4\uB85D
      \uD558\uACA0\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 592599068672
    m_Localized: "\uCE74\uB4DC \uD0C0\uC785\n<sprite=1>: \uD654\uC5FC          <sprite=2>:
      \uBE59\uACB0          <sprite=0>: \uC790\uC5F0\n<sprite=4>: \uAE30\uB3C4         
      <sprite=5>: \uC131\uB825          <sprite=3>: \uC138\uB840\n<sprite=7>: \uCC38\uACA9         
      <sprite=8>: \uD0C0\uACA9          <sprite=6>: \uBC29\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 891279650816
    m_Localized: "\uAC01 \uD0C0\uC785\uBCC4 \uCE74\uB4DC\uB4E4\uC740 \uC5F0\uACC4\uB418\uC5B4
      \uD6A8\uACFC\uAC00 \uAC15\uD654\uB418\uB294 \uB300\uC751 \uD0C0\uC785\uC774
      \uC874\uC7AC\uD569\uB2C8\uB2E4\n\uC774\uB54C \uC5F0\uACC4 \uB300\uC0C1 \uCE74\uB4DC\uB294
      \uD14C\uB450\uB9AC\uAC00 \uC774\uD399\uD2B8\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 137299751189622784
    m_Localized: "\uCE74\uB4DC \uCF54\uC2A4\uD2B8"
    m_Metadata:
