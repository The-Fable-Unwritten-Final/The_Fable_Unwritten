      m_Items: []
  - m_Id: 2459622191104
    m_Localized: "\u672A\u4F7F\u7528\u306E\u5834\u5408, \u3053\u306E\u6226\u95D8\u304C\u7D42\u4E86\u3059\u308B\u307E\u3067\u30C7\u30C3\u30AD\u304B\u3089\u9664\u5916\u3055\u308C\u308B"
