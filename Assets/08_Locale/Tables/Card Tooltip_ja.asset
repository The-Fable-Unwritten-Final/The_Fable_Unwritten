      m_Items: []
  - m_Id: 3797366091776
    m_Localized: "\u6B21\u306B\u4F7F\u7528\u3059\u308B\u30AB\u30FC\u30C9\u306E\u52B9\u679C\u304C2\u56DE\u9069\u7528\u3055\u308C\u308B\u3002"
