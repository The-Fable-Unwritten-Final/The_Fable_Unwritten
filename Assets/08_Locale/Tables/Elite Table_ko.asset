      m_Items: []
  - m_Id: 1234910588928
    m_Localized: "\uC2E0\uB8B0"
    m_Metadata:
      m_Items: []
  - m_Id: 1240077971456
    m_Localized: "\uAD8C\uC704"
    m_Metadata:
      m_Items: []
  - m_Id: 1245333434368
    m_Localized: "\uBC29\uC5B4\uB825 +{0}\n\uACF5\uACA9 \uD53C\uD574\uB97C \uBC1B\uC744
      \uB54C\uB9C8\uB2E4 1 \uAC10\uC18C\n0\uC774 \uB418\uBA74 \uB2E4\uC74C \uC801
      \uD134\uC5D0 \uACF5\uACA9\uB825 +{1}, \uD574\uB958 \uD30C\uB3D9 \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 1251008327680
    m_Localized: "\uC801 \uD134 \uC885\uB8CC \uC2DC \uC0DD\uC874\uD55C \uD50C\uB9BD\uC774
      \uC788\uC73C\uBA74 +1\n{0}\uC77C \uB54C \uB2E4\uC74C \uC801 \uD134 \uC2DC\uC791
      \uC2DC \uD50C\uB9BD\uC744 \uC81C\uAC70\uD558\uACE0\n\uC544\uAD70 \uC804\uCCB4\uC5D0\uAC8C
      \uD53C\uD574 {1} \uBC0F \uC2A4\uD0DD \uCD08\uAE30\uD654\n\uC801 \uD134 \uC885\uB8CC
      \uC2DC {0} \uBBF8\uB9CC\uC774\uBA74 \uD50C\uB9BD \uC18C\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 1257656299520
    m_Localized: "\uBC1B\uC740 \uACF5\uACA9 \uD53C\uD574\uB9CC\uD07C \uAC10\uC18C\n0\uC774
      \uB418\uBA74 \uC0BC\uD0A8 \uB300\uC0C1\uC744 \uBC49\uC5B4\uB0C4\n\uD50C\uB808\uC774\uC5B4
      \uD134 \uC885\uB8CC \uC2DC \uC2A4\uD0DD\uC774 \uC874\uC7AC\uD560 \uACBD\uC6B0\n\uB300\uC0C1\uC5D0\uAC8C
      \uD53C\uD574 {0}, \uCCB4\uB825 {1} \uD68C\uBCF5 \uD6C4 \uBC49\uC5B4\uB0C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1266401423360
    m_Localized: "\uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC74C\n\uBC49\uC5B4\uC9C0\uAC70\uB098
      \uADF8\uB864\uB9AC\uAC00 \uCC98\uCE58\uB418\uBA74 \uC989\uC2DC \uD574\uC81C\n\uC0BC\uD0A4\uAC70\uB098
      \uBC49\uC744 \uB54C \uBC1B\uB294 \uD53C\uD574\uB85C \uCCB4\uB825\uC774 0\uC774
      \uB418\uC9C0 \uC54A\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1273183612928
    m_Localized: '{0}

      {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 1279273742336
    m_Localized: '{0}

      {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 1286181761024
    m_Localized: '{0}

      {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 1293584707584
    m_Localized: "\uBB34\uBA85\uAC80\uAC1D\uC744 \uACF5\uACA9 \uC2DC \uC790\uC2E0\uACFC
      \uBB34\uBA85\uAC80\uAC1D\uC758 '\uD569' +1\n\uBB34\uBA85\uAC80\uAC1D\uC5D0\uAC8C
      \uC8FC\uB294 \uACF5\uACA9 \uD53C\uD574\uAC00 '\uD569' 1\uB2F9 +{0}\n\uD574\uC81C
      \uC2DC '\uD569' \uC804\uBD80 \uC81C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 1299758723072
    m_Localized: "\uCD5C\uB300 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 410836730916864
    m_Localized: "\uCD5C\uB300 {0}\n'\uB300\uBA74' \uC0C1\uD0DC\uAC00 \uC544\uB2CC
      \uACF5\uACA9\uC744 \uBC1B\uC73C\uBA74 -{1} (\uD134\uB2F9 \uCD5C\uB300 {2})\n\uC218\uCE58\uAC00
      \uB192\uC744\uC218\uB85D \uC77C\uC12C \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 410838026956800
    m_Localized: "\uB2E4\uC74C \uD729\uC4F8\uAE30\uC758 \uB300\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 410838651908096
    m_Localized: "\uC774\uBC88 \uD50C\uB808\uC774\uC5B4 \uD134\uC5D0 \uACF5\uACA9\uD55C
      \uC544\uAD70\uC758 \uC218\n3 \uC774\uC0C1\uC77C \uACBD\uC6B0 \uB2E4\uC74C \uC801
      \uD134\uC5D0 \uB300\uD68C\uC804 \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 410896109678592
    m_Localized: "\uB204\uC801 \uD53C\uD574 {0}, \uBC1B\uB294 \uCD94\uAC00 \uD53C\uD574
      +{1}%\n\uD50C\uB808\uC774\uC5B4 \uD134 \uC885\uB8CC \uC2DC \uD574\uC81C\n\uD574\uC81C
      \uC2DC \uC783\uC740 \uCCB4\uB825\uC758 {2}% \uD68C\uBCF5(\uCD5C\uB300 {3})\n\uB204\uC801
      \uD53C\uD574\uAC00 {4} \uC774\uC0C1\uC774\uBA74 \uACF5\uACA9\uB825 +{5},\n{6}
      \uC774\uC0C1\uC774\uBA74 \uBC29\uC5B4\uB825 +{7}"
    m_Metadata:
      m_Items: []
  - m_Id: 410898248773632
    m_Localized: "\uCD5C\uB300 {0}\n\uACF5\uACA9 \uD53C\uD574\uB97C \uBC1B\uC744
      \uB54C\uB9C8\uB2E4 -1\n\uB300\uC5F4 1\uB2F9 \uAE30\uC0AC\uB2E8\uC7A5\uC774
      \uBC1B\uB294 \uACF5\uACA9 \uD53C\uD574 -{1}%(\uCD5C\uB300 {2}%)"
    m_Metadata:
      m_Items: []
  - m_Id: 410899578368000
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uBAA8\uB4E0 \uAC80\uC740 \uBCD1\uC0AC\uB839\uC758
      \uB300\uC5F4 +{0}\n\uC774\uBC88 \uD134\uC5D0 \uCE74\uB4DC\uB97C \uAC00\uC7A5
      \uB9CE\uC774 \uC0AC\uC6A9\uD55C \uC544\uAD70\uC744 \uC9C0\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 410900182347776
    m_Localized: "\uB2E4\uC74C \uD134\uC5D0 \uD589\uB3D9\uD558\uC9C0 \uC54A\uC74C\n\uB2E4\uC74C
      \uD50C\uB808\uC774\uC5B4 \uD134 \uC885\uB8CC \uC804\uAE4C\uC9C0 \uBC1B\uB294
      \uACF5\uACA9 \uD53C\uD574 +{0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 410900756967424
    m_Localized: "\uB2E4\uC74C \uC801 \uD134 \uC885\uB8CC\uAE4C\uC9C0 \uACF5\uACA9\uB825
      +{1}\n\uB2E4\uC74C \uD50C\uB808\uC774\uC5B4 \uD134\uC5D0 \uCC98\uC74C \uBC1C\uC0DD\uD558\uB294
      \uB300\uC5F4 \uAC10\uC18C \uBB34\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 410901327392768
    m_Localized: "\uCD5C\uB300 {0}\n\uCE74\uB4DC \uD6A8\uACFC -{1}%\n{2} \uC774\uC0C1\uC77C
      \uB54C '\uC704\uCD95' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 410901927178240
    m_Localized: "\uCE74\uB4DC \uD6A8\uACFC -{0}%\n'\uC758\uC2EC'\uC774 {1} \uBBF8\uB9CC\uC77C
      \uB54C \uC81C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 410902510186496
    m_Localized: "\uC758\uC2EC\uC744 \uD574\uC18C\uD55C \uD69F\uC218 {0}\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 410906985508864
    m_Localized: "\uC544\uAD70 \uC804\uCCB4\uC5D0\uAC8C \uD53C\uD574 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 411085981626368
    m_Localized: "\uD50C\uB808\uC774\uC5B4 \uC804\uCCB4\uC5D0\uAC8C \uD53C\uD574
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 411089630670848
    m_Localized: "\uD50C\uB808\uC774\uC5B4 \uC804\uCCB4\uC5D0\uAC8C \uD53C\uD574
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 411092403105792
    m_Localized: "\uBAA8\uB4E0 \uC5D8\uB8E8\uC544\uC758 \uACF5\uACA9\uB825 +{0},
      \uBC29\uC5B4\uB825 +{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 411094542200832
    m_Localized: "\uBAA8\uB4E0 \uC5D8\uB8E8\uC544\uC758 \uBC29\uC5B4\uB825 +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 411096232505344
    m_Localized: "\uACF5\uACA9\uB825 +{0}, \uBC29\uC5B4\uB825 +{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 411098338045952
    m_Localized: "\uBAA8\uB4E0 \uC5D8\uB8E8\uC544\uC758 \uCCB4\uB825 {0} \uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 411100993040384
    m_Localized: "\uCCB4\uB825\uC774 \uAC00\uC7A5 \uB0AE\uC740 \uC5D8\uB8E8\uC544\uC758
      \uCCB4\uB825 {0} \uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 411104268791808
    m_Localized: "\uCCB4\uB825 {0} \uD68C\uBCF5\uD558\uACE0 \uBC29\uC5B4\uB825 +{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 411185294356480
    m_Localized: "\uD310\uB3C5 \uC131\uACF5 \uC2DC -{0}\n\uD65C\uC131\uC73C\uB85C
      \uAC10\uC18C\uD55C \uBE44\uC6A9\uB9CC\uD07C \uAC10\uC18C(\uCE74\uB4DC\uB2F9
      \uCD5C\uB300 {1})\n\uC801 \uD134 \uC2DC\uC791 \uC2DC \uD654\uC0C1 \uD53C\uD574
      {2}\uB2F9 -1(\uCD5C\uB300 {3})"
    m_Metadata:
      m_Items: []
  - m_Id: 411186925940736
    m_Localized: "\uD310\uB3C5 \uC131\uACF5 \uC2DC \uC0C8\uB85C\uC6B4 \uB8EC\uC73C\uB85C
      \uBCC0\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 411187580252160
    m_Localized: "0\uC774 \uB418\uBA74 \uB8EC \uD3ED\uD48D \uC0AC\uC6A9\n\uC801 \uD134
      \uC885\uB8CC \uC2DC -1(\uB8EC \uD3ED\uD48D\uC744 \uC0AC\uC6A9\uD55C \uD134
      \uC81C\uC678)"
    m_Metadata:
      m_Items: []
  - m_Id: 411188217786368
    m_Localized: "{0}\uD68C \uC774\uC0C1 \uD310\uB3C5 \uC2DC \uAC00\uC7A5 \uB9CE\uC740
      \uD0C0\uC785\uC73C\uB85C \uB2E4\uC74C \uB8EC \uD3ED\uD48D \uC57D\uD654\n\uD654\uC5FC:
      \uD53C\uD574 -{1}, \uC5BC\uC74C: \uC0C1\uD0DC\uC774\uC0C1 {2}\uAC1C \uC81C\uAC70\n\uC790\uC5F0:
      \uB2E4\uC74C \uD134 \uC18C\uD53C\uC544\uC758 \uD65C\uC131 {3} \uC99D\uAC00,\n\uCE74\uB4DC
      {4}\uC7A5 \uCD94\uAC00 \uB4DC\uB85C\uC6B0"
    m_Metadata:
      m_Items: []
  - m_Id: 411188758851584
    m_Localized: "\uAE30\uB3C4/\uC138\uB840\uB97C \uC801\uC5D0\uAC8C \uC0AC\uC6A9:
      \uD5CC\uC2E0 +1\n\uAE08\uAE30\uB97C \uC544\uAD70\uC5D0\uAC8C \uC0AC\uC6A9:
      \uC9D1\uCC29 +1"
    m_Metadata:
      m_Items: []
  - m_Id: 411242513051648
    m_Localized: "\uBC1B\uB294 \uACF5\uACA9 \uD53C\uD574 -{0}%\n\uADE0\uD615/\uC9D1\uCC29\uC73C\uB85C
      \uAC10\uC18C,\n\uD5CC\uC2E0\uC73C\uB85C \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 411243129614336
    m_Localized: "\uD50C\uB808\uC774\uC5B4 \uD134 \uC885\uB8CC \uC2DC \uC9D1\uCC29\uBCF4\uB2E4
      \uB192\uC740 \uACBD\uC6B0\n\uC801 \uD134 \uC2DC\uC791 \uC2DC \uB2E4\uC74C \uC2A4\uD0AC
      \uC57D\uD654\n\uB8E8\uC2DC\uC5D8\uC758 \uCCB4\uB825\uACFC \uC2E0\uC131 \uC7A5\uB9C9
      \uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 411243700039680
    m_Localized: "\uD50C\uB808\uC774\uC5B4 \uD134 \uC885\uB8CC \uC2DC \uD5CC\uC2E0\uBCF4\uB2E4
      \uB192\uC740 \uACBD\uC6B0\n\uC801 \uD134 \uC2DC\uC791 \uC2DC \uB2E4\uC74C \uC2A4\uD0AC
      \uAC15\uD654, \uC2E0\uC131 \uC7A5\uB9C9 \uAC10\uC18C\n\uAC15\uD654 \uC2A4\uD0AC\uC774
      \uD68C\uBCF5/\uBC84\uD504 \uC2A4\uD0AC\uC774\uBA74,\n\uD50C\uB808\uC774\uC5B4
