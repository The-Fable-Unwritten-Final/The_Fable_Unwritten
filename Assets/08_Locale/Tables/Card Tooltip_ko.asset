  - m_Id: 24971325440
    m_Localized: "\uD654\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 1049329414144
    m_Localized: "\uD134 \uC2DC\uC791 \uC2DC {0}\uB9CC\uD07C \uD53C\uD574\uB97C \uC785\uACE0,
      \uBC1C\uB3D9 \uD6C4 \uD654\uC0C1 \uC218\uCE58 1\uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 1055549566976
    m_Localized: "\uACF5\uACA9 \uD53C\uD574\uAC00 {0}\uB9CC\uD07C \uAC10\uC18C\uD558\uBA70
      \uD134 \uC885\uB8CC \uC2DC \uBE59\uACB0 \uC81C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 1057327951872
    m_Localized: "\uB2E4\uC74C\uC5D0 \uC801\uC6A9\uB418\uB294 \uBAA8\uB4E0 \uC0C1\uD0DC\uC774\uC0C1\uC758
      \uC218\uCE58\uB97C \uC99D\uAC00\uC2DC\uD0A4\uACE0 \uBC1C\uB3D9 \uD6C4 \uC0AC\uB77C\uC9C4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1063862677504
    m_Localized: "\uD65C\uC131 {0}\uB2F9 \uB2E4\uC74C\uC5D0 \uC0AC\uC6A9\uD558\uB294
      \uCE74\uB4DC\uC758 \uBE44\uC6A9\uC774 1 \uAC10\uC18C\n\uAC10\uC18C\uD55C \uBE44\uC6A9
      1\uB2F9 \uD65C\uC131 {0}\uC744 \uC18C\uBAA8"
    m_Metadata:
      m_Items: []
  - m_Id: 1064479240192
    m_Localized: "\uD134 \uC885\uB8CC \uC2DC \uC8C4\uC545 \uC218\uCE58 {0}\uB9CC\uD07C
      \uD53C\uD574\uB97C \uC785\uB294\uB2E4\n\uC774\uD6C4 \uC8C4\uC545 \uC218\uCE58
      \uC81C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 1065179688960
    m_Localized: "\uBC1B\uB294 \uD574\uB85C\uC6B4 \uD6A8\uACFC\uB97C  \uCC38\uD68C
      \uC218\uCE58 {0}\uB9CC\uD07C \uAC10\uC18C\uC2DC\uD0A4\uBA70,\n\uCC38\uD68C
      \uC218\uCE58 \uC81C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 1065762697216
    m_Localized: "\uC0C1\uCC98\uAC00 {0} \uC774\uC0C1\uC77C \uB54C, \uACF5\uACA9\uBC1B\uC73C\uBA74
      \uC0C1\uCC98\uAC00 \uC804\uBD80 \uC81C\uAC70\uB418\uACE0,\n\uD574\uB2F9 \uD134
      \uB3D9\uC548 \uACF5\uACA9\uB2F9\uD560 \uB54C\uB9C8\uB2E4 \uCD94\uAC00 \uD53C\uD574
      {1}\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1149493587968
    m_Localized: "{0}% \uD655\uB960\uB85C 1\uD134 \uB3D9\uC548 \uD589\uB3D9\uD560
      \uC218 \uC5C6\uAC8C \uB41C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1150806405120
    m_Localized: "\uC801\uC758 \uACF5\uACA9\uC744 \uC790\uC2E0\uC5D0\uAC8C \uC720\uB3C4\uD558\uACE0,\n\uC218\uD638
      \uC218\uCE58\uC778 {0}\uB9CC\uD07C \uBC1B\uB294 \uD53C\uD574\uB97C \uAC10\uC18C\uC2DC\uD0A8
      \uD6C4 \uC218\uD638\uAC00 \uC81C\uAC70\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
