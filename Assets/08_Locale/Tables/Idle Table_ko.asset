  - m_Id: 784622694400
    m_Localized: "\uB77C\uC774\uC628\uD558\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 880156356608
    m_Localized: "\uADF8\uB9BC\uC790 \uC218\uD638\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 99860623360
    m_Localized: "\uD578\uB4DC \uB0B4 \uCE74\uB4DC \uC911 \uD55C \uC7A5\uC774 \uBCF4\uB77C\uC0C9\uC73C\uB85C
      \uBE5B\uB0A9\uB2C8\uB2E4.\n\uBE5B\uB098\uB294 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD560
      \uB54C\uB9C8\uB2E4 \uB2E4\uB978 \uBB34\uC791\uC704 \uCE74\uB4DC\uAC00 \uC0C8\uB85C
      \uBE5B\uB098\uBA70,\n\uBE5B\uC774 \uC5C6\uB294 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD558\uAE30
      \uC804\uAE4C\uC9C0 \uBAA8\uB4E0 \uCE74\uB4DC\uC758 \uBE44\uC6A9\uC774 0\uC774
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 209516507136
    m_Localized: "\uD578\uB4DC \uB0B4 \uBAA8\uB4E0 \uCE74\uB4DC\uB97C \uBC84\uB9AC\uACE0
      \uBC84\uB9B0 \uCE74\uB4DC \uBE44\uC6A9\uC758 \uD569\uC5D0 \uB530\uB77C \uC77C\uD68C\uC131
      \uCE74\uB4DC \uD558\uB098\uB97C \uD578\uB4DC\uC5D0 \uCD94\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 524689092608
    m_Localized: "\uC544\uAD70 \uC804\uCCB4\uC758 \uD604\uC7AC \uCCB4\uB825\uC744
      \uC783\uC740 \uB9CC\uD07C\uC758 \uCCB4\uB825\uC73C\uB85C \uC804\uD658\uD569\uB2C8\uB2E4.\n\uB9CC\uC57D
      \uCCB4\uB825\uC774 \uAC10\uC18C\uD558\uAC8C \uB418\uBA74 '\uC9C0\uC18D \uD68C\uBCF5'
      \uC0C1\uD0DC\uB97C \uC801\uC6A9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 529294438400
    m_Localized: "\uB79C\uB364\uC73C\uB85C '\uC790\uBE44' \uB610\uB294 '\uC2EC\uD310'
      \uCE74\uB4DC\uB97C \uD578\uB4DC\uC5D0 \uCD94\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 788426928128
    m_Localized: "2\uD134 \uB3D9\uC548 '\uCCA0\uD608' \uC0C1\uD0DC\uAC00 \uB418\uACE0,
      \uC804\uD22C\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 '\uC57D\uC810 \uB178\uCD9C'
      \uC0C1\uD0DC\uAC00 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1036515815424
    m_Localized: "\uD604\uC7AC \uC801\uC774 \uBCF4\uC720\uD55C \uBAA8\uB4E0 \uD574\uB85C\uC6B4
      \uD6A8\uACFC\uC758 \uC218\uCE58\uB97C 3\uBC30\uB85C \uC99D\uAC00 \uC2DC\uD0A4\uBA70(\uCD5C\uB300\uCE58
      \uCD08\uACFC \uBD88\uAC00), \uCD08\uACFC\uD55C \uC218\uCE58 \uB9CC\uD07C \uB808\uC774
      \uB300\uC2E0 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
