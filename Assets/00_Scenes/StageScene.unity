    - target: {fileID: 2713661009830906786, guid: 79312473a988b464b95d3efd6e017624,
        type: 3}
      propertyPath: m_text
      value: "\uC6B0\uCE21 \uC0C1\uB2E8\uC758 '\uB3C4\uB85C\uC2DC\uC758 \uCC45'\uC744
        \uD1B5\uD574 \uD574\uAE08\uB41C \uCE74\uB4DC\uB97C \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\uB610\uD55C
        \uC124\uC815\uCC3D\uC5D0\uC11C \uC74C\uB7C9\uC744 \uC870\uC808\uD558\uAC70\uB098
        \uBAA8\uD5D8 \uC911 \uD0C0\uC774\uD2C0\uB85C \uB3CC\uC544\uAC08 \uC218\uB3C4
        \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5354770399206639182, guid: 79312473a988b464b95d3efd6e017624,
        type: 3}
      propertyPath: m_text
      value: "\uC801\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uACBD\uD5D8\uCE58\uC640
        \uC804\uB9AC\uD488\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4.\\n\uACBD\uD5D8\uCE58\uB294
        \uD654\uBA74 \uC0C1\uB2E8\uC5D0 \uD45C\uC2DC\uB418\uBA70 \uC57C\uC601\uC9C0\uC5D0\uC11C
        \uCE74\uB4DC\uB97C \uAD50\uCCB4\uD560 \uB54C \uC0AC\uC6A9\uB429\uB2C8\uB2E4.\\n\uC804\uB9AC\uD488\uC740
        \uC0C8\uB85C\uC6B4 \uBAA8\uD5D8\uC744 \uC2DC\uC791\uD55C \uD6C4 \uCE74\uB4DC\uB97C
        \uD574\uAE08\uD560 \uB54C \uC0AC\uC6A9\uB429\uB2C8\uB2E4.\\n\uC9C0\uAE08\uBD80\uD130\uB294
        \uC6D0\uD558\uB294 \uAE38\uC744 \uC120\uD0DD\uD558\uC5EC \uC790\uC720\uB86D\uAC8C
        \uBAA8\uD5D8\uD574\uC8FC\uC138\uC694.\\n\uC9C4\uD589\uB3C4\uB294 \uB178\uB4DC
        \uC120\uD0DD \uC2DC \uC790\uB3D9 \uC800\uC7A5\uB429\uB2C8\uB2E4."
      objectReference: {fileID: 0}
