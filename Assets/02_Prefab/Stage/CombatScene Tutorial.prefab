  m_text: "\uAC01 \uCE90\uB9AD\uD130\uC758 \uCE74\uB4DC\uB294 4\uAC00\uC9C0 \uD0C0\uC785\uC73C\uB85C
    \uB098\uB269\uB2C8\uB2E4.\\n\uD2B9\uC815 \uD0C0\uC785 2\uAC1C\uB97C \uC5F0\uC18D\uC73C\uB85C
    \uC0AC\uC6A9\uD558\uBA74 \uCE74\uB4DC\uC758 \uB370\uBBF8\uC9C0\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\\n->                   
    ->                    ->\n\\n->                    ->                    ->\n\n\uC5F0\uACC4
    \uD6A8\uACFC\uC758 \uB300\uC0C1\uC774 \uB418\uB294 \uCE74\uB4DC\uB294 \uD14C\uB450\uB9AC\uAC00
    \uD2B9\uBCC4\uD55C \uC774\uD399\uD2B8\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\uCD94\uD6C4
