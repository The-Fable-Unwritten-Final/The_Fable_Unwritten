  m_text: "\uD328\uC5D0 \uC788\uB294 \uCE74\uB4DC\uC5D0 \uCEE4\uC11C\uB97C \uC62C\uB824\uC11C
    \uCE74\uB4DC\uC758 \uBE44\uC6A9, \uD6A8\uACFC, \uD0C0\uC785\uACFC \uCE74\uB4DC\uC758
    \uC8FC\uC778\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\uCE74\uB4DC\uB97C
