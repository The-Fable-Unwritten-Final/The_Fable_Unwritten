  m_text: "\uC6B0\uCE21 \uC0C1\uB2E8\uC758 '\uB3C4\uB85C\uC2DC\uC758 \uCC45'\uC744
    \uD1B5\uD574 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uCE74\uB4DC\uB97C \uBCFC
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\uB610\uD55C \uC124\uC815\uCC3D\uC5D0\uC11C
